# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — `.env.example` is the tracked template.

# Google OAuth client ids. Only the WEB one is read by the app:
#
# GOOGLE_OAUTH_WEB_CLIENT_ID — the "Web application" client of the SAME Cloud
#   project as the Android clients. Android sign-in passes it as
#   serverClientId (google_sign_in 7). Without it, Sign in still grants Drive
#   access but can't show the account's email, and debug builds warn at
#   startup. Never put a client secret here: .env ships inside the app.
#
# The Android ids are for reference only: Google matches the package name +
# signing SHA-1 itself. iOS reads GIDClientID from ios/Runner/Info.plist.
GOOGLE_OAUTH_ANDROID_DEBUG_CLIENT_ID=
GOOGLE_OAUTH_ANDROID_UPLOAD_CLIENT_ID=
GOOGLE_OAUTH_ANDROID_PLAY_CLIENT_ID=
GOOGLE_OAUTH_IOS_CLIENT_ID=
GOOGLE_OAUTH_WEB_CLIENT_ID=

# Security feature visibility (build-time). Controls whether each toggle is
# shown in Settings → Security. The user still controls whether the toggle is
# ON or OFF — these flags only decide if the toggle row is rendered at all.
# Both default to true if missing/blank. Set to "false" to hide a toggle.
ENABLE_FINGERPRINT_GATE=true
ENABLE_PIN_GATE=true
